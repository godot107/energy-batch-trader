# ============================================================================
#  Execution target when not in dry-run: dry_run | alpaca_paper | robinhood
#  (the CLI --paper / --live flags override this).
# ============================================================================
EOD_BROKER=dry_run

# ----------------------------------------------------------------------------
#  Alpaca — market data + Phase 2 PAPER trading (use your *paper* account keys).
#  Same keys drive both. Falls back to synthetic data if unset; paper trading
#  places no real money.
# ----------------------------------------------------------------------------
ALPACA_API_KEY=your_alpaca_paper_key
ALPACA_SECRET_KEY=your_alpaca_paper_secret

# ============================================================================
#  Execution — Robinhood official Agentic Trading MCP (Phase 3, REAL money)
#  Connect the MCP via your agent's connector flow (you approve access in the
#  Robinhood app — never paste your password). Then export the issued token.
#  Orders execute only in your isolated, separately-funded Agentic account.
# ============================================================================
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_MCP_TOKEN=your_oauth_token_from_the_connector_flow

# ----------------------------------------------------------------------------
#  Telegram notifications (optional; skipped if unset)
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ----------------------------------------------------------------------------
#  EIA Open Data API (optional; fundamental inventory gate skipped if unset)
#  Free key: https://www.eia.gov/opendata/register.php
# ----------------------------------------------------------------------------
EIA_API_KEY=your_free_eia_api_key

# ----------------------------------------------------------------------------
#  Anomaly detection LLM (optional; scan skipped if unset)
# ----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key
# OR
GEMINI_API_KEY=your_gemini_api_key

# ============================================================================
#  LEGACY — unofficial robin_stocks path (superseded by the official MCP above)
# ============================================================================
# ROBINHOOD_USERNAME=your_email@example.com
# ROBINHOOD_PASSWORD=your_password
# ROBINHOOD_MFA_CODE=your_totp_if_needed
